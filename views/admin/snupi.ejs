<!-- views/admin/snupis.ejs -->

<% layout("layouts/admin2") %>

<main class="main-content"> <div class="container-fluid">
<!-- PAGE HEADER -->
<h3 class="mb-4">
  <a href="/admin/academic">
    <i class="fa fa-book me-2"></i>
    Snupi
  </a>
  / HolaSnupi
</h3>


<div class="row">

  <!-- ========================= -->
  <!-- FORMULARIO -->
  <!-- ========================= -->
  <div class="col-lg-4 col-md-5 mb-4">

    <div class="card">

      <div class="card-header">
        <h6 class="mb-0" id="cardTitle">
          <i class="fa fa-plus me-2"></i>
          Nuevo Snupi
        </h6>
      </div>

      <div class="card-body">

        <form method="POST" action="/snupi">

          <div class="mb-3">

            <label for="name" class="form-label">
              Nombre
            </label>

            <input type="hidden" name="" id="snupiId">

            <input
              type="text"
              id="nombre"
              name="nombre"
              class="form-control"
              placeholder="Ingrese el nombre de Snupi..."
              required
            >
          </div>

          <div class="mb-3">

            <label for="name" class="form-label">
              Categoria
            </label>

            <input
              type="text"
              id="categoria"
              name="categoria"
              categoria="categoria"
              class="form-control"
              placeholder="Ingrese la categoria de Snupi..."
              required
            >

          </div>

          <div class="mb-3">

            <label for="name" class="form-label">
              Descripcion
            </label>

            <input
              type="text"
              id="descripcion"
              name="descripcion"
              descripcion="descripcion"
              class="form-control"
              placeholder="Ingrese la descripcion de Snupi..."
              required
            >
          </div>

          
          <div class="mb-3">

            <label for="name" class="form-label">
              Es Infaltable?
            </label>

            <input
              type="text"
              id="esInfaltable"
              name="esInfaltable"
              esInfaltable="esInfaltable"
              class="form-control"
              placeholder="Ingrese si es infaltable de Snupi..."
              required
            >
          </div>


          <div class="d-flex justify-content-end gap-2">

            <button
              class="btn btn-outline-secondary"
              onclick="limpiar(event)"
            >
              <i class="fa fa-refresh me-1"></i>
              Limpiar
          </button>

            <button
              type="submit"
              class="btn btn-success"
              id="btnGuardar"
              onclick="agregar(event)"
            >
              <i class="fa fa-save me-1"></i>
              Guardar
            </button>

          </div>

        </form>

      </div>

    </div>

  </div>


  <!-- ========================= -->
  <!-- LISTADO -->
  <!-- ========================= -->
  <div class="col-lg-8 col-md-7 mb-4">

    <div class="card">

      <div class="card-header">
        <h6 class="mb-0">
          <i class="fa fa-list me-2"></i>
          Lista de Snupi
        </h6>
      </div>


      <div class="card-body">

        <!-- HEADER ACTIONS -->
        <div class="d-flex justify-content-between align-items-center mb-3">

          <div class="text-muted">
            <i class="fa fa-graduation-cap me-1"></i>
            Snupi registrado
          </div>

          <div>
            <a
              href="/snupi/new"
              class="btn btn-success"
            >
              <i class="fa fa-plus"></i>
              Agregar Registro
            </a>
          </div>

        </div>


        <!-- TABLE -->
        <div class="table-responsive">

          <table class="table table-striped table-hover" id="snupis">

            <thead>
              <tr>
                <th>ID</th>
                <th>Nombre</th>
                <th>Categoria</th>
                <th>Descripcion</th>
                <th>Es Infaltable</th>
                <th class="text-end">Acciones</th>
              </tr>
            </thead>


            <tbody>

              <% if (snupi && snupi.length > 0) { %>

                <% for (const snup of snupi) { %>

                  <tr>

                    <td>
                      <%= snup.id %>
                    </td>

                    <td>
                      <%= snup.nombre %>
                    </td>

                    <td>
                      <%= snup.categoria %>
                    </td>

                    <td>
                      <%= snup.descripcion %>
                    </td>

                    <td>
                      <%= snup.esInfaltable %>
                    </td>

                    <td class="text-end">

                      <button
                        class="btn btn-sm btn-outline-secondary me-1"
                        onclick="editar(<%= snup.id %>, event)"
                      >
                        <i class="fa fa-edit" ></i>
                        Editar
                    </button>

                      <button
                        class="btn btn-sm btn-outline-danger"
                        onclick="eliminar(<%= snup.id %>, event)"
                      >
                        <i class="fa fa-trash"></i>
                        Eliminar
                    </button>

                    </td>

                  </tr>

                <% } %>

              <% } else { %>

                <tr>
                  <td colspan="3" class="text-center text-muted py-4">
                    No se encontraron snupis.
                  </td>
                </tr>

              <% } %>

            </tbody>

          </table>

        </div>

      </div>

    </div>

  </div>

</div>

</div> </main>

<script>
    let snupiRows = document.getElementById("snupis").children[1].children.length;

    function limpiar(event){
      event.preventDefault();
      document.getElementById("snupiId").value="";
      document.getElementById("nombre").value="";
      document.getElementById("categoria").value="";
      document.getElementById("descripcion").value="";
      document.getElementById("esInfaltable").value="";
      document.getElementById("cardTitle").innerHTML = "Nuevo Snupi";
    }

    function agregar(event){
        event.preventDefault();

        let nombre = document.getElementById("nombre").value;
        let categoria = document.getElementById("categoria").value;
        let descripcion = document.getElementById("descripcion").value;
        let esInfaltable = document.getElementById("esInfaltable").value;
        let snupiTable = document.getElementById("snupis");
        let snupiId = document.getElementById("snupiId").value;

        if(snupiId==""){
          let tr = document.createElement("TR");
          let td1 = document.createElement("TD");
          let td2 = document.createElement("TD");
          let td3 = document.createElement("TD");
          let td4 = document.createElement("TD");
          let td5 = document.createElement("TD");
          let td6 = document.createElement("TD");

          snupiRows = snupiRows + 1;
          td1.innerHTML = snupiRows;
          td2.innerHTML = nombre;
          td3.innerHTML = categoria;
          td4.innerHTML = descripcion;
          td5.innerHTML = esInfaltable;

          tr.appendChild(td1);
          tr.appendChild(td2);
          tr.appendChild(td3);
          tr.appendChild(td4);
          tr.appendChild(td5);
          tr.appendChild(td6);

          console.log(tr);

          snupiTable.children[1].appendChild(tr);
        }else{
          let tbody = snupiTable.children[1];

          for (let tr of tbody.children) {
            console.log("1 ++++++++++++++++++++")
            console.log(typeof tr.children[0].innerHTML.trim())
            console.log(typeof snupiId)
            if(tr.children[0].innerHTML.trim() == snupiId){
              tr.children[1].innerHTML = nombre;
              tr.children[2].innerHTML = categoria;
              tr.children[3].innerHTML = descripcion;
              tr.children[4].innerHTML = esInfaltable;
              document.getElementById("snupiId").value="";
              document.getElementById("nombre").value="";
              document.getElementById("categoria").value="";
              document.getElementById("descripcion").value="";
              document.getElementById("esInfaltable").value="";
              document.getElementById("cardTitle").innerHTML = "Nuevo Snupi";
            }
          }
        }
    }

    function eliminar(id, event){
        let tr = event.currentTarget.parentElement.parentElement;
        tr.remove();
    }

    function editar(id, event){
        let tr = event.currentTarget.parentElement.parentElement;
        let idRow = tr.children[0].innerHTML;
        let name = tr.children[1].innerHTML;

        document.getElementById("cardTitle").innerHTML = "Editar snupia";

        document.getElementById("name").value = name.trim();
        document.getElementById("snupiId").value = id;
    }
</script>